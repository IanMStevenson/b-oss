# Blipfoto developer app credentials
# A key with a trailing `# optional` comment may be left empty or absent. packages/b-mobile-pc/scripts/env-check.mjs
# (run by that package's Windows build script) compares this file with .env.local and stops the build
# for any other key that .env.local lacks; refresh .env.local when this file changes (see CLAUDE.md).
# Register your app(s) at https://www.blipfoto.com/developer/apps

# --- Desktop b-ark (Electron) ---
# Register as "distributed app" type with redirect URI: b-ark://oauth/callback
# Must be prefixed MAIN_VITE_ so electron-vite exposes it to the main process via import.meta.env
MAIN_VITE_BLIPFOTO_CLIENT_ID= # optional (b-ark only; the b-mobile builds do not read it)

# --- b-ark-chrome (browser extension) ---
# Register a SEPARATE "distributed app" with redirect URI: bark-chrome://oauth/callback
# (a dedicated scheme so an installed desktop b-ark can't intercept the redirect).
# Prefixed VITE_ so vite exposes it to the extension at build time. Without this,
# the "Sign in to Blipfoto" button silently does nothing (empty client_id).
# Read from the repo root (vite.config sets envDir to the repo root).
VITE_CHROME_CLIENT_ID= # optional (b-ark-chrome only; the b-mobile builds do not read it)

# --- b-mobile (Capacitor app) ---
# Register a SEPARATE "distributed app" with redirect URI: bmobile://oauth/ — the trailing
# slash is required by Blipfoto's registration form, and the redirect_uri check is exact-string
# (app-architecture.md §16, §18). Use the app registered on the project's own Blipfoto account,
# never one from a test account; changing it means a rebuild and every account signing in again.
VITE_BLIPFOTO_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=bmobile://oauth/ # optional (this is also the built-in default)
# Dev-only, desktop-browser testing: a token obtained outside the app (e.g. Blipfoto's own
# app-admin pages), auto-applied at launch in place of a real OAuth round, which a desktop
# browser can't complete (no bmobile:// redirect capture — app-architecture.md §16, §19).
# Has no effect in a production build. Never commit a real value.
VITE_DEV_TOKEN= # optional
# b-mobile: set to 1 to build the one-shot feed-depth probe (b-oss#196); leave unset for releases
VITE_FEED_PROBE= # optional
# b-push (the cloud notification service) base URL and shared registration secret — the secret
# is a coarse gate, not a credential (packages/b-push/ARCHITECTURE.md); never commit a real
# value.
VITE_NOTIFY_SERVICE_URL= # optional (Android push only; the desktop app polls instead)
VITE_NOTIFY_REGISTRATION_SECRET= # optional (Android push only)
# Map tile provider key (app-architecture.md §13) — extractable from the bundle by design, so
# the provider choice should tolerate a public key. Never commit a real value regardless.
VITE_GEOAPIFY_KEY=

# --- b-mobile debug build beside the Play build (b-oss#462) ---
# The debug build (`npm run build:android-debug` in packages/b-mobile, then `npx cap sync android`
# and `./gradlew assembleDebug`) installs as uk.co.salientpoint.bmobile.debug with the link scheme
# bmobile-debug://, so it can sit next to the Play install. Give it its OWN Blipfoto "distributed
# app" (redirect bmobile-debug://oauth/) and put these two lines in .env.android-debug.local
# (gitignored; they override .env.local for that build only; everything else is inherited):
#   VITE_BLIPFOTO_CLIENT_ID=<the debug app's client ID>
#   VITE_OAUTH_REDIRECT_URI=bmobile-debug://oauth/
# google-services.json needs a client for uk.co.salientpoint.bmobile.debug as well as the release
# one (add a second Android app in the same Firebase project and re-download the file).
