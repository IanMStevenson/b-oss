# Blipfoto developer app credentials
# Register your app(s) at https://www.blipfoto.com/developer/apps

# --- Desktop b-ark (Electron) ---
# Register as "distributed app" type with redirect URI: b-ark://oauth/callback
# Must be prefixed MAIN_VITE_ so electron-vite exposes it to the main process via import.meta.env
MAIN_VITE_BLIPFOTO_CLIENT_ID=

# --- b-ark-chrome (browser extension) ---
# Register a SEPARATE "distributed app" with redirect URI: bark-chrome://oauth/callback
# (a dedicated scheme so an installed desktop b-ark can't intercept the redirect).
# Prefixed VITE_ so vite exposes it to the extension at build time. Without this,
# the "Sign in to Blipfoto" button silently does nothing (empty client_id).
# Read from the repo root (vite.config sets envDir to the repo root).
VITE_CHROME_CLIENT_ID=

# --- b-mobile (Capacitor app) ---
# Register a SEPARATE "distributed app" with redirect URI: bmobile://oauth/ — the trailing
# slash is required by Blipfoto's registration form, and the redirect_uri check is exact-string
# (app-architecture.md §16, §18).
VITE_BLIPFOTO_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=bmobile://oauth/
# Dev-only, desktop-browser testing: a token obtained outside the app (e.g. Blipfoto's own
# app-admin pages), auto-applied at launch in place of a real OAuth round, which a desktop
# browser can't complete (no bmobile:// redirect capture — app-architecture.md §16, §19).
# Has no effect in a production build. Never commit a real value.
VITE_DEV_TOKEN=
# b-push (the cloud notification service) base URL and shared registration secret — the secret
# is a coarse gate, not a credential (notification-service.md); never commit a real value.
VITE_NOTIFY_SERVICE_URL=
VITE_NOTIFY_REGISTRATION_SECRET=
# Map tile provider key (app-architecture.md §13) — extractable from the bundle by design, so
# the provider choice should tolerate a public key. Never commit a real value regardless.
VITE_MAP_TILES_KEY=
