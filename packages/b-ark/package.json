{
  "name": "b-ark",
  "version": "1.0.5",
  "private": true,
  "description": "b-ark Blipfoto journal backup for desktop",
  "author": {
    "name": "Ian Stevenson",
    "email": "Ian.Stevenson@cyclops-online.co.uk"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/copy-icons.mjs && electron-vite dev",
    "build": "node ../../scripts/copy-icons.mjs && electron-vite build",
    "typecheck": "electron-vite typecheck",
    "release": "node ../../scripts/copy-icons.mjs && electron-builder --publish always",
    "pack": "node ../../scripts/copy-icons.mjs && electron-vite build && electron-builder --dir",
    "predist": "npm run build --workspace=packages/b-view-backup",
    "dist": "node ../../scripts/copy-icons.mjs && electron-vite build && electron-builder",
    "dist:win": "node ../../scripts/copy-icons.mjs && electron-vite build && electron-builder --win",
    "pack:mac": "node ../../scripts/copy-icons.mjs && electron-vite build && electron-builder --mac --universal --publish never",
    "release:mac": "node ../../scripts/copy-icons.mjs && electron-vite build && electron-builder --mac --universal --publish always",
    "test": "vitest run"
  },
  "dependencies": {
    "@b-oss/b-ark-ui-electron": "*",
    "@b-oss/backup-engine": "*",
    "@b-oss/b-api": "*",
    "@b-oss/b-view-backup": "*",
    "electron-log": "^5.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.4.3",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
