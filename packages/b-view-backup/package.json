{
  "name": "@b-oss/b-view-backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:app": "node ../../scripts/copy-icons.mjs && vite build",
    "build:debug": "node ../../scripts/copy-icons.mjs && vite build --mode development",
    "build": "npm run build:app",
    "dev": "node ../../scripts/copy-icons.mjs && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@b-oss/b-view": "*",
    "@b-oss/backup-engine": "*",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}
