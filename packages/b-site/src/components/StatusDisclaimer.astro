---
// The "unofficial" notice under the header on every status page.
import { BLIPFOTO_HELP, BLIPFOTO_SUPPORT_REQUEST } from '../blipfoto-links';
---

<div class="st-disclaimer" role="note">
  <div class="st-disclaimer-inner">
    <span class="st-disclaimer-icon" aria-hidden="true">i</span>
    <p>
      <strong>Unofficial.</strong> This page is run by b-oss, an independent open-source project. It is
      not operated by, affiliated with or endorsed by Blipfoto, and
      <strong>problems shared here do not go to Blipfoto</strong>. For help from Blipfoto, use
      <a href={BLIPFOTO_HELP}>Blipfoto support</a> or <a href={BLIPFOTO_SUPPORT_REQUEST}>contact Blipfoto</a>.
    </p>
  </div>
</div>
