---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureItem from '../components/FeatureItem.astro';
import PhoneShots from '../components/PhoneShots.astro';
import StoreBadge from '../components/StoreBadge.astro';
---

<Layout
  title="b-mobile for Blipfoto · b-oss"
  description="b-mobile for Blipfoto: browse, post and get notified on your Blipfoto journal from your Android phone. Open source, from b-oss."
  nav="b-mobile"
>
  <Hero label="b-mobile hero" icon="b-mobile" title="b-mobile - the unofficial blipfoto app">Browse, post and join in from your Android phone. Free, with no ads.</Hero>

  <section class="block" data-screen-label="Introduction">
    <p class="section-eyebrow">Introduction</p>
    <div class="prose" style="margin-top: 18px">
      <p>
        b-mobile is a Blipfoto app for Android. It is an open-source project, part of b-oss and
        led by Ian Stevenson, and is published on the Google Play Store on behalf of the
        development team by Salient Point Consulting Ltd. It is built on Blipfoto's public API
        and works with your existing Blipfoto account.
      </p>
    </div>

    <ul class="feature-list" style="margin-top: 28px; max-width: 720px">
      <FeatureItem><strong>Browse.</strong> Recent, Following, Popular, Milestones, New Blippers and
          Nearby, plus search and a map of blips.</FeatureItem>
      <FeatureItem><strong>Post.</strong> Take or choose a photo and publish.</FeatureItem>
      <FeatureItem><strong>Join in.</strong> Star, favourite, comment, reply and follow.</FeatureItem>
      <FeatureItem><strong>Stay in touch.</strong> Optional notifications for new comments and activity,
          and a daily reminder to post.</FeatureItem>
      <FeatureItem><strong>Your accounts.</strong> Sign in with more than one Blipfoto account and
          switch instantly.</FeatureItem>
      <FeatureItem><strong>In control.</strong> Hide members you don't want to see, and report anything
          that breaks the rules.</FeatureItem>
    </ul>

  </section>

  <section class="block" data-screen-label="Screenshots">
    <p class="section-eyebrow">Screenshots</p>
    <PhoneShots
      shots={[
        { name: 'browse', alt: 'b-mobile Browse screen: a grid of recent photos with tabs for Recent, Following, Me, Popular and Milestones.', caption: 'Browse' },
        { name: 'entry', alt: 'An entry in b-mobile: the photo, its title and description, star and favourite buttons and the camera details.', caption: 'An entry' },
        { name: 'map', alt: 'The b-mobile map with pins marking where blips were taken across the UK and Europe.', caption: 'Map' },
      ]}
    />
  </section>

  <section class="block" data-screen-label="Good to know">
    <p class="section-eyebrow">Good to know</p>
    <div class="prose" style="margin-top: 18px">
      <p>
        <strong>Free.</strong> b-mobile is completely free to use, with no ads and no in-app
        purchases. It works with your existing Blipfoto account, whatever kind it is; any paid
        Blipfoto features are separate from this app.
      </p>
      <p><strong>Only the app can:</strong></p>
      <ul>
        <li>
          <strong>Switch accounts seamlessly.</strong> Sign in with more than one account and switch
          instantly.
        </li>
        <li>
          <strong>Send real notifications.</strong> On your phone, for new comments and activity, plus
          a daily reminder to post.
        </li>
        <li>
          <strong>Browse through a grid.</strong> An optional extra bar on an entry moves you through
          the grid you came from, rather than through that member's journal. Turn it on in Settings
          &gt; Appearance; you can hide it or turn it off again at any time.
        </li>
      </ul>
      <p><strong>Only the website can:</strong></p>
      <ul>
        <li><strong>Extra images.</strong> Upload and view them.</li>
        <li><strong>Full-size originals.</strong> Show and save them.</li>
      </ul>
      <p>
        b-mobile can't show or save these, because blipfoto doesn't let apps like it do so. You can
        still download the standard-size photo of your own entries. On a phone, blipfoto's own way to
        use the website is to add a link to it to your phone's home screen. For now that is still the
        only way to upload and view extra images.
      </p>
    </div>
  </section>

  <section class="block" id="download" data-screen-label="Get it">
    <p class="section-eyebrow">Get it</p>
    <div class="tri-links">
      <div class="tri-link" data-link="play-store">
        <div class="store-badges"><StoreBadge product="b-mobile" store="play" /></div>
        <h3>Google Play</h3>
        <p>Install b-mobile on your Android phone.</p>
        <a class="tri-link-more" href="b-mobile-guide" data-link="user-guide">User guide →</a>
      </div>

      <div class="tri-link" data-link="microsoft-store">
        <div class="store-badges"><StoreBadge product="b-mobile-windows" store="microsoft" label="b-mobile" /></div>
        <h3>Microsoft Store</h3>
        <p>Coming soon. The same app for Windows.</p>
        <a class="tri-link-more" href="b-mobile-guide" data-link="windows-user-guide">User guide →</a>
      </div>
    </div>
  </section>

  <CtaBand />

  <div class="btn-row btn-row-center">
    <a class="btn" href="b-mobile-privacy">b-mobile privacy policy</a>
    <a class="btn" href="b-mobile-data-deletion">Delete your b-mobile data</a>
  </div>
</Layout>
