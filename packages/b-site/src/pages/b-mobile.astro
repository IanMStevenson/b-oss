---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PhoneShots from '../components/PhoneShots.astro';
import StoreBadge from '../components/StoreBadge.astro';

const features = [
  { title: 'Browse', text: 'Recent, Following, Popular, Milestones, New Blippers and Nearby, plus search and a map of blips.' },
  { title: 'Post', text: 'Take or choose a photo and publish, even on a poor connection.' },
  { title: 'Join in', text: 'Star, favourite, comment, reply and follow.' },
  { title: 'Stay in touch', text: 'Optional notifications for new comments and activity, and a daily reminder to post.' },
  { title: 'Your accounts', text: 'Sign in with more than one Blipfoto account and switch instantly.' },
  { title: 'In control', text: "Hide members you don't want to see, and report anything that breaks the rules." },
];
---

<Layout
  title="b-mobile for Blipfoto · b-oss"
  description="b-mobile for Blipfoto: browse, post and get notified on your Blipfoto journal from your Android phone. Open source, from b-oss."
  nav="b-mobile"
>
  <Hero label="b-mobile hero" icon="b-mobile" title="b-mobile for Blipfoto">Browse, post and get notified on your Blipfoto journal, from your Android phone.</Hero>

  <div class="hero-actions" data-screen-label="Get it">
    <StoreBadge product="b-mobile" store="play" label="b-mobile" />
    <a class="btn" href="b-mobile-guide">Read the user guide</a>
  </div>
  <p class="hero-note">Free to use. No ads. No in-app purchases.</p>

  <section class="block" data-screen-label="Screenshots">
    <PhoneShots
      shots={[
        { name: 'browse', alt: 'b-mobile Browse screen: a grid of recent photos with tabs for Recent, Following, Me, Popular and Milestones.', caption: 'Browse' },
        { name: 'entry', alt: 'An entry in b-mobile: the photo, its title and description, star and favourite buttons and the camera details.', caption: 'An entry' },
        { name: 'map', alt: 'The b-mobile map with pins marking where blips were taken across the UK and Europe.', caption: 'Map' },
      ]}
    />
  </section>

  <section class="block" data-screen-label="What it does">
    <p class="section-eyebrow">What it does</p>
    <ul class="feature-grid">
      {features.map((f) => (
        <li>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" data-screen-label="Good to know">
    <p class="section-eyebrow">Good to know</p>
    <div class="note-grid">
      <div class="note-card">
        <h3>Extra images and full-size photos</h3>
        <p>
          Blipfoto doesn't let apps like b-mobile show extra images or full-size originals, so
          b-mobile can't show or save them. You can still download the standard-size photo of
          your own entries.
        </p>
        <p>
          Blipfoto's own way to use it on a phone is to add a link to the Blipfoto website to your
          phone's home screen. For now that is still the only way to upload and view extra images.
        </p>
      </div>
      <div class="note-card">
        <h3>Your account</h3>
        <p>
          b-mobile works with your existing Blipfoto account, whatever kind it is. Any paid
          Blipfoto features are separate from this app.
        </p>
      </div>
    </div>
  </section>

  <section class="block" data-screen-label="About">
    <p class="section-eyebrow">About this app</p>
    <div class="prose" style="margin-top: 18px">
      <p>
        b-mobile is open source, part of b-oss and led by Ian Stevenson. It is built on
        Blipfoto's public API and published on Google Play by Salient Point Consulting Ltd on
        behalf of the development team.
      </p>
      <p>
        <a href="b-mobile-privacy">Privacy policy</a> ·
        <a href="b-mobile-data-deletion">Delete your data</a> ·
        <a href="https://github.com/IanMStevenson/b-oss">Source code on GitHub</a> ·
        <a href="contact">Contact</a>
      </p>
    </div>
  </section>
</Layout>
