---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import StoreBadge from '../components/StoreBadge.astro';
---

<Layout
  title="Which backup tool? · b-oss"
  description="b-oss offers two ways to back up your Blipfoto journal — b-ark (Windows desktop) and b-ark-chrome (Chrome extension). Here's how to choose."
>
  <Hero label="Hero" icon="b-oss" title="Which backup tool is right for you?">b-ark runs on a timer on your PC. b-ark-chrome backs up as you post, in your browser.</Hero>

  <div class="bands">
  <section class="block band-tint" data-screen-label="Quick guide">
    <div class="prose" style="max-width: 720px">
      <p>
        <strong>Choose b-ark if</strong> you're on a Windows PC and post from anywhere, including your
        phone or tablet. It backs up on a timer, as long as your PC is on, and handles several accounts.
      </p>
      <p>
        <strong>Choose b-ark-chrome if</strong> you're on Windows, Mac or Linux and post from your
        computer. It backs up as you post, and when you next visit Blipfoto in Chrome or Edge, for one
        account.
      </p>
    </div>
  </section>

  <section class="block" data-screen-label="Comparison table">
    <div class="prose" style="overflow-x: auto">
      <table class="compare-table">
        <thead>
          <tr>
            <th></th>
            <th>b-ark</th>
            <th>b-ark-chrome</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Platform</td>
            <td data-label="b-ark">Windows only</td>
            <td data-label="b-ark-chrome">Chrome or Edge on Windows, Mac or Linux</td>
          </tr>
          <tr>
            <td>How backup triggers</td>
            <td data-label="b-ark">On a timer — runs in the background whether or not you visit Blipfoto</td>
            <td data-label="b-ark-chrome">When you publish a blip, or when you visit a Blipfoto page after a gap</td>
          </tr>
          <tr>
            <td>If you post from phone or tablet</td>
            <td data-label="b-ark">&#10003; Timer fires regardless of how or where you post</td>
            <td data-label="b-ark-chrome">Backup triggers next time you open Blipfoto in the browser on that machine</td>
          </tr>
          <tr>
            <td>Backup on publish</td>
            <td data-label="b-ark">Not available</td>
            <td data-label="b-ark-chrome">&#10003; Captures new blips within seconds of posting from your computer</td>
          </tr>
          <tr>
            <td>Mac / Linux support</td>
            <td data-label="b-ark">&#10007;</td>
            <td data-label="b-ark-chrome">&#10003;</td>
          </tr>
          <tr>
            <td>Number of accounts</td>
            <td data-label="b-ark">Multiple accounts</td>
            <td data-label="b-ark-chrome">Single account</td>
          </tr>
          <tr>
            <td>Backup completeness</td>
            <td data-label="b-ark">Full — gap-check and redo run on schedule</td>
            <td data-label="b-ark-chrome">Full — gap-check and redo run on every trigger</td>
          </tr>
          <tr>
            <td>Get it</td>
            <td data-label="b-ark"><StoreBadge product="b-ark" store="microsoft" /></td>
            <td data-label="b-ark-chrome"><StoreBadge product="b-ark-chrome" store="chrome" /></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  </div>

  <CtaBand />
</Layout>
