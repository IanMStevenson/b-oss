---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureItem from '../components/FeatureItem.astro';
import StoreBadge from '../components/StoreBadge.astro';
---

<Layout
  title="b-ark · b-oss"
  description="Archive your blips on your own device. b-ark is a Windows app from b-oss."
  nav="b-ark"
>
  <Hero label="b-ark hero" icon="b-ark" title="b-ark - backup for blipfoto">Backup apps for your PC or Chrome browser. Keep your own copy of every blip.</Hero>

  <section class="block" data-screen-label="Introduction">
    <p class="section-eyebrow">Introduction</p>
    <div class="prose" style="margin-top: 18px">
      <p>
        b-ark makes a local copy of every blip you've ever posted (images, text and metadata) on
        your own machine, automatically keeping it up to date. Browse offline, publish to the
        web, or hand over to AI tools to explore and create new formats.
      </p>
    </div>

    <ul class="feature-list" style="margin-top: 28px; max-width: 720px">
      <FeatureItem><strong>Backup.</strong> A local copy of every blip, updated automatically.</FeatureItem>
      <FeatureItem><strong>View.</strong> Browse your archive offline in the built-in viewer.</FeatureItem>
      <FeatureItem><strong>Publish.</strong> Copy the backup folder to any web host to publish.</FeatureItem>
      <FeatureItem><strong>AI-ready.</strong> README.md for AI tools: Use AI to build photobooks,
          slideshows, statistics, custom sites.</FeatureItem>
    </ul>
  </section>

  <div style="max-width: 520px; margin: 0 auto 48px">
    <div class="shot">
      <img
        src="assets/b-ark-screenshot.png"
        alt="The b-ark app showing an account with archived photos."
      />
    </div>
  </div>

  <section class="block" data-screen-label="b-ark or b-ark-chrome">
    <p class="section-eyebrow">b-ark or b-ark-chrome</p>
    <div class="prose two-col">
      <div>
        <h3>Choose b-ark if…</h3>
        <p>
          you regularly post from your phone or tablet and want your backup to happen on a
          timer, automatically, regardless of whether you open a browser. As long as your
          Windows PC is running, b-ark will keep your archive up to date.
        </p>
      </div>
      <div>
        <h3>Choose b-ark-chrome if…</h3>
        <p>
          you're on Mac or Linux, you usually post from your computer, or you want the
          simplest possible setup — one click from the Chrome Web Store, and silent automatic
          updates.
        </p>
      </div>
    </div>
    <div class="btn-row btn-row-center">
      <a class="btn primary" href="b-ark-versions">Compare in detail →</a>
    </div>
  </section>

  <section class="block" id="download" data-screen-label="Get it">
    <p class="section-eyebrow">Get it</p>
    <div class="tri-links">
      <div class="tri-link" id="get-b-ark" data-link="microsoft-store">
        <div class="store-badges"><StoreBadge product="b-ark" store="microsoft" /></div>
        <h3>b-ark</h3>
        <p>Windows desktop app. Backs up on a timer, wherever you post from.</p>
        <a class="tri-link-more" href="b-ark-guide" data-link="user-guide">User guide →</a>
      </div>

      <div class="tri-link" id="get-b-ark-chrome" data-link="web-store">
        <div class="store-badges"><StoreBadge product="b-ark-chrome" store="chrome" /></div>
        <h3>b-ark-chrome</h3>
        <p>Browser extension for Chrome or Edge, on Windows, Mac or Linux.</p>
        <a class="tri-link-more" href="b-ark-chrome-guide" data-link="chrome-user-guide">User guide →</a>
      </div>
    </div>
  </section>

  <CtaBand />

  <div class="btn-row btn-row-center">
    <a class="btn" href="b-ark-privacy">b-ark privacy policy</a>
    <a class="btn" href="b-ark-chrome-privacy">b-ark-chrome privacy policy</a>
  </div>
</Layout>
