---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import PhoneShots from '../components/PhoneShots.astro';
import StoreBadge from '../components/StoreBadge.astro';
---

<Layout
  title="b-oss - free tools for blipfoto"
  description="Free, open-source tools for blipfoto: b-mobile to browse and post, b-ark and b-ark-chrome to keep your own copy of your blips, and an unofficial status page."
  nav="home"
>
  <Hero label="Hero" icon="b-oss" title="b-oss - free tools for blipfoto">Apps to browse and post from your phone and to keep your own copy of your blips, plus a page that shows whether blipfoto is working. Free and open source.</Hero>

  <div class="bands">
  <section class="app-card" data-screen-label="App: b-mobile">
    <div class="app-card-meta">
      <div class="app-card-head">
        <img src="assets/b-oss-icon.png" alt="" />
        <div>
          <h2>b-mobile</h2>
          <div class="tagline">The blipfoto app: browse, post and get notified.</div>
        </div>
      </div>
      <p class="summary">
        Browse everything, post a blip from your camera or gallery, join in with stars, favourites
        and comments, and choose whether to be notified. Free, with no ads. On Android now; the same
        app is coming to Windows.
      </p>
      <div class="store-badges">
        <StoreBadge product="b-mobile" store="play" />
        <StoreBadge product="b-mobile-windows" store="microsoft" label="b-mobile" />
      </div>
      <div class="btn-row">
        <a class="btn" href="b-mobile">Learn more →</a>
      </div>
    </div>
    <PhoneShots
      shots={[
        { name: 'browse', alt: 'b-mobile Browse screen: a grid of recent photos with tabs for Recent, Following, Me, Popular and Milestones.', caption: 'Browse' },
        { name: 'entry', alt: 'An entry in b-mobile: the photo, its title and description, star and favourite buttons and the camera details.', caption: 'An entry' },
        { name: 'map', alt: 'The b-mobile map with pins marking where blips were taken across the UK and Europe.', caption: 'Map' },
      ]}
    />
  </section>

  <section class="app-card band-tint" data-screen-label="App: b-ark">
    <div class="app-card-meta">
      <div class="app-card-head">
        <img src="assets/b-oss-icon.png" alt="" />
        <div>
          <h2>b-ark</h2>
          <div class="tagline">Backup on your PC: a Windows desktop app.</div>
        </div>
      </div>
      <p class="summary">
        Keeps your own copy of your blips on a timer, even when you post from your phone, as long as
        your PC is on. Browse them offline, or publish them to the web.
      </p>
      <div class="store-badges">
        <StoreBadge product="b-ark" store="microsoft" />
      </div>
      <div class="btn-row">
        <a class="btn" href="b-ark">Learn more →</a>
      </div>
    </div>
    <div class="shot">
      <img
        src="assets/b-ark-screenshot.png"
        alt="The b-ark app showing an account with archived photos."
      />
    </div>
  </section>

  <section class="app-card" data-screen-label="App: b-ark-chrome">
    <div class="app-card-meta">
      <div class="app-card-head">
        <img src="assets/b-oss-icon.png" alt="" />
        <div>
          <h2>b-ark-chrome</h2>
          <div class="tagline">Backup in your browser: a Chrome extension for Windows, Mac and Linux.</div>
        </div>
      </div>
      <p class="summary">
        Keeps your own copy of your blips. It saves each new blip moments after you post from your
        computer, and catches up whenever you visit blipfoto. No installer, no timer to set.
      </p>
      <div class="store-badges">
        <StoreBadge product="b-ark-chrome" store="chrome" />
      </div>
      <div class="btn-row">
        <a class="btn" href="b-ark">Learn more →</a>
      </div>
    </div>
    <div class="shot">
      <img
        src="assets/guide-chrome/status-chip.png"
        alt="A browser showing blipfoto, with the b-ark-chrome backup progress chip beside the logo."
      />
    </div>
  </section>

  <section class="band-tint" data-screen-label="b-status">
    <CtaBand href="status" label="See the status">
      <strong>Is blipfoto working?</strong> b-status checks every 15 minutes and shows the history.
      Unofficial; not run by blipfoto.
    </CtaBand>
  </section>

  <section class="block" data-screen-label="For developers">
    <p class="section-eyebrow">For developers</p>
    <div class="prose">
      <p>
        b-oss is open source. <a href="https://github.com/IanMStevenson/b-oss">Read the code on
        GitHub</a>; issues and pull requests are welcome. Building something of your own?
        <a href="b-api">b-api</a> is our TypeScript client for the blipfoto API, free to reuse.
      </p>
    </div>
  </section>
  </div>

  <CtaBand />

  <div class="btn-row">
    <a class="btn" href="privacy">b-oss privacy policies</a>
  </div>
</Layout>
