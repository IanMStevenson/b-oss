---
import { BLIPFOTO_FACEBOOK_PAGE, BLIPFOTO_FRIENDS_GROUP, BLIPFOTO_SUPPORT_REQUEST } from '../blipfoto-links';
import Layout from '../layouts/Layout.astro';
import StatusDisclaimer from '../components/StatusDisclaimer.astro';
---

<Layout
  title="Blipfoto status (unofficial) · b-oss"
  description="An independent, unofficial check of whether the Blipfoto website and API are working, with history. Not run by Blipfoto."
  nav="status"
>
  <a slot="top" class="skip-link" href="#uptime">Skip the charts and go to the uptime table and incident list</a>

  <StatusDisclaimer slot="below-header" />

  <div class="status-page">
    <section class="st-banner st-banner-loading" aria-labelledby="st-now-title" data-now>
      <noscript>
        <h1 id="st-now-title">Blipfoto status</h1>
        <p class="st-loading">This page needs JavaScript to show live status.</p>
      </noscript>
    </section>

    <p class="st-more">
      For more information see the official <a href={BLIPFOTO_FACEBOOK_PAGE} target="_blank" rel="noopener">Blipfoto Facebook page</a>,
      or <a href={BLIPFOTO_FRIENDS_GROUP} target="_blank" rel="noopener">Blipfoto Friends</a>.
    </p>

    <section class="st-section" aria-labelledby="st-48-title">
      <h2 id="st-48-title">Last 48 hours</h2>
      <ul class="st-legend" aria-label="Key">
        <li><span class="st-key st-key-down"></span><strong>Not working</strong></li>
        <li><span class="st-key st-key-nodata"></span><strong>No data</strong></li>
        <li><span class="st-key st-key-shared"></span><strong>User reports</strong> (not verified)</li>
      </ul>
      <p class="st-sub st-collecting" data-collecting></p>
      <div data-lanes></div>
    </section>

    <section class="st-section" aria-labelledby="st-hist-title">
      <h2 id="st-hist-title">Last 30 days</h2>
      <div data-history></div>
    </section>

    <section class="st-section" id="uptime" aria-labelledby="st-uptime-title">
      <h2 id="st-uptime-title">Uptime</h2>
      <div data-uptime></div>
    </section>

    <section class="st-section" id="incidents" aria-labelledby="st-inc-title">
      <h2 id="st-inc-title">Incidents</h2>
      <div data-incidents></div>
    </section>

    <section class="st-section st-share" id="share" aria-labelledby="st-share-title">
      <h2 id="st-share-title">Seeing a problem?</h2>
      <p class="st-lead">Share it with others.</p>
      <div class="st-form-card" data-share hidden>
        <form novalidate>
          <div data-error class="st-form-error" role="alert" hidden>
            <strong>That didn’t work.</strong> Nothing was shared. Please try again.
          </div>
          <div data-fields>
            <fieldset class="st-fieldset">
              <legend class="st-legend-q">What are you using?</legend>
              <div class="st-options">
                <label class="st-option">
                  <input type="radio" name="using" value="website" />
                  <span><strong>The website</strong><span class="st-sub">blipfoto.com</span></span>
                </label>
                <label class="st-option">
                  <input type="radio" name="using" value="app" />
                  <span><strong>An app</strong><span class="st-sub">b-ark, b-mobile…</span></span>
                </label>
              </div>
            </fieldset>
            <fieldset class="st-fieldset">
              <legend class="st-legend-q">What’s happening?</legend>
              <div class="st-options">
                <label class="st-option">
                  <input type="radio" name="what" value="offline" />
                  <span><strong>It’s offline</strong><span class="st-sub">Won’t load or connect</span></span>
                </label>
                <label class="st-option">
                  <input type="radio" name="what" value="degraded" />
                  <span><strong>It’s not working right</strong><span class="st-sub">Loads, but something’s wrong</span></span>
                </label>
              </div>
            </fieldset>
            <fieldset class="st-fieldset">
              <legend class="st-legend-q">Anything specific? <span class="st-sub">Optional</span></legend>
              <div class="st-chips">
                <label class="st-chip-opt"><input type="checkbox" name="tag" value="login" /><span>Login</span></label>
                <label class="st-chip-opt"><input type="checkbox" name="tag" value="uploads" /><span>Uploads</span></label>
                <label class="st-chip-opt"><input type="checkbox" name="tag" value="slow" /><span>Slow</span></label>
                <label class="st-chip-opt"><input type="checkbox" name="tag" value="unreliable" /><span>Unreliable</span></label>
              </div>
            </fieldset>
          </div>
          <button type="submit" class="st-btn st-btn-primary st-btn-wide" data-submit aria-describedby="st-share-why" disabled>Share</button>
          <span id="st-share-why" class="st-sr">Share is available once you have answered both questions above.</span>
          <p class="st-share-note">
            Reports stay on this page and are not sent to Blipfoto.
            <a href={BLIPFOTO_SUPPORT_REQUEST} target="_blank" rel="noopener">Contact Blipfoto Support</a>
          </p>
          <div class="st-turnstile" data-turnstile>Anti-bot check (Cloudflare Turnstile)</div>
          <p class="st-privacy"><a href="privacy.html">Privacy</a></p>
        </form>
        <div class="st-already" data-already hidden>
          <h3 tabindex="-1">You’ve already shared a report</h3>
          <p>Thanks. Your earlier report is counted, but this one wasn’t added.</p>
        </div>
        <div class="st-thanks" data-thanks role="dialog" aria-modal="true" aria-labelledby="st-thanks-title" hidden>
          <div class="st-thanks-card">
            <h3 id="st-thanks-title" tabindex="-1">Thanks, your report is in</h3>
            <p>It can take a minute or two to appear on this page. To get it fixed, tell Blipfoto Support.</p>
            <div class="st-thanks-actions">
              <a class="st-btn st-btn-primary" href={BLIPFOTO_SUPPORT_REQUEST} target="_blank" rel="noopener">Contact Blipfoto Support ↗</a>
              <button type="button" class="st-btn" data-done>Done</button>
            </div>
          </div>
        </div>
        <noscript><p class="st-sub">Sharing a problem needs JavaScript.</p></noscript>
      </div>
    </section>
  </div>

  <Fragment slot="scripts">
    <script>
      import { start } from '../status/main';

      // The only place build-time settings are read (PUBLIC_* variables; see README "Status page").
      start({
        statusUrl: String(import.meta.env.PUBLIC_STATUS_URL ?? ''),
        turnstileKey: String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''),
        loadFixtures: import.meta.env.DEV ? () => import('../status/fixtures') : undefined,
      });
    </script>
  </Fragment>
</Layout>
