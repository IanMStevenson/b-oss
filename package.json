{
  "name": "b-oss",
  "private": true,
  "version": "1.0.6",
  "description": "Open-source tools for Blipfoto users — including backing up Blipfoto journals",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "version:bump": "node scripts/version.mjs",
    "copy-icons": "node scripts/copy-icons.mjs",
    "prebuild": "npm run version:bump && npm run copy-icons",
    "build": "npm run build --workspaces --if-present",
    "build:release": "node scripts/build-release.mjs",
    "typecheck": "node scripts/ci-scope.mjs run typecheck --packages all",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\"",
    "setup": "node scripts/setup.js",
    "fetch-entry": "node scripts/fetch-entry.mjs",
    "postinstall": "node -e \"if(process.env.ELECTRON_SKIP_BINARY_DOWNLOAD==='1')process.exit(0);try{require('fs').accessSync('node_modules/electron/install.js')}catch{process.exit(0)}require('child_process').execFileSync(process.execPath,['node_modules/electron/install.js'],{stdio:'inherit'})\"",
    "prepare": "husky"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
